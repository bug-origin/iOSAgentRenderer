{
  "name": "composition-gallery",
  "title": "坐标网格",
  "context": {
    "threadId": "",
    "viewId": "composition-gallery",
    "revision": 1
  },
  "spec": {
    "root": "root",
    "elements": {
      "root": {
        "type": "Card",
        "props": {
          "title": "坐标网格"
        },
        "children": [
          "diagram",
          "followup"
        ]
      },
      "diagram": {
        "type": "Diagram",
        "props": {
          "chart": "flowchart LR\nA[原点] --> B[X 轴]\nA --> C[Y 轴]"
        },
        "children": []
      },
      "followup": {
        "type": "Followup",
        "props": {
          "prompts": [
            "显示网格",
            "隐藏网格"
          ],
          "value": {
            "$bindState": "/ui/followup"
          }
        },
        "children": [],
        "on": {
          "press": {
            "action": "dispatch",
            "params": {
              "actionId": "sample.choose",
              "input": {
                "$state": "/ui/followup"
              }
            }
          }
        }
      }
    }
  },
  "state": {
    "data": {},
    "form": {},
    "ui": {
      "followup": ""
    }
  }
}
