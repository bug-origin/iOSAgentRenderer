{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "context",
    "spec",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "agent-ui/0.2"
    },
    "context": {
      "type": "object",
      "required": [
        "threadId",
        "viewId",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "threadId": {
          "type": "string"
        },
        "viewId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "spec": {
      "$ref": "spec.schema.json"
    },
    "state": {
      "type": "object",
      "required": [
        "data",
        "form",
        "ui"
      ],
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object"
        },
        "form": {
          "type": "object"
        },
        "ui": {
          "type": "object"
        }
      }
    }
  }
}
